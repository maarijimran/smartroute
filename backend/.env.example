# Settings for running the gateway directly (without Docker). Copy to backend/.env.
# Every variable has the prefix SMARTROUTE_. See app/config.py for the full list.

SMARTROUTE_ENV=development
SMARTROUTE_DATABASE_URL=sqlite:///./smartroute.db
# Server: postgresql+psycopg://smartroute:PASSWORD@localhost:5432/smartroute

SMARTROUTE_BOOTSTRAP_ADMIN_EMAIL=admin@smartroute.local
SMARTROUTE_BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Required when SMARTROUTE_ENV=production (see ../.env.example for how to generate):
# SMARTROUTE_SECRET_KEY=
# SMARTROUTE_ENCRYPTION_KEY=

SMARTROUTE_CORS_ORIGINS=http://localhost:3000
SMARTROUTE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default local model. On the GPU server scripts/register_ollama_tiers.py registers
# gpt-oss:20b, qwen3.5:9b and qwen3.6:27b as the tiers instead (see SETUP.md 3a).
SMARTROUTE_LOCAL_MODEL=llama3.1:8b

# Laptop: leave these off (regex detectors only, mock models seeded).
# Server: turn all three on after installing requirements-ml.txt.
# GLiNER uses the GPU when available (SMARTROUTE_PII_GLINER_DEVICE=auto|cuda|cpu).
SMARTROUTE_PII_PRESIDIO=false
SMARTROUTE_PII_GLINER=false
SMARTROUTE_EMBEDDINGS_ENABLED=false

# OCR for photos and scanned PDFs.
# Laptop: "mock" returns fixed, clearly labelled text so the upload flow can be tried.
# Server: "vllm" with the URL of the local vLLM server running baidu/Unlimited-OCR.
SMARTROUTE_OCR_BACKEND=mock
SMARTROUTE_OCR_BASE_URL=http://localhost:8001/v1
