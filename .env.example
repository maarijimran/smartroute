# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.

# --- Secrets: generate each one, do not reuse ---------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SMARTROUTE_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts the stored cloud API keys. If you lose it, every stored key must be re-entered.
SMARTROUTE_ENCRYPTION_KEY=

# --- First superadmin account (used only on the very first start) --------------
SMARTROUTE_BOOTSTRAP_ADMIN_EMAIL=admin@smartroute.local
SMARTROUTE_BOOTSTRAP_ADMIN_PASSWORD=

# --- Public URLs as seen from a user's browser ---------------------------------
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# --- Local model and detectors --------------------------------------------------
SMARTROUTE_LOCAL_MODEL=llama3.1:8b
SMARTROUTE_PII_PRESIDIO=true
SMARTROUTE_PII_GLINER=true
# OCR for photos and scanned PDFs (baidu/Unlimited-OCR on vLLM): vllm or off.
SMARTROUTE_OCR_BACKEND=vllm
# Share of GPU memory vLLM may take for OCR (Ollama and GLiNER share the GPU).
OCR_GPU_MEMORY_UTILIZATION=0.35
# Turn on only after scripts/fit_features.py has written artifacts/features.json
# with the embedding block:
SMARTROUTE_EMBEDDINGS_ENABLED=false
